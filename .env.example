PORT=5000

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=booknook

# Client (Next.js) origin(s) allowed by CORS, comma separated
CLIENT_URL=http://localhost:3000

# Seed script: the user who "owns" the sample books.
# Use the email you registered with, so the books show up in My Books.
SEED_OWNER_NAME=BookNook Librarian
SEED_OWNER_EMAIL=librarian@booknook.dev
