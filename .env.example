PORT=5000

# MongoDB
MONGODB_URI=
# Client (Next.js) origin(s) allowed by CORS, comma separated
CLIENT_URL=http://localhost:3000

# Base URL of the Next.js app that runs Better Auth (must match BETTER_AUTH_URL in the client).
# The server downloads the public keys from <AUTH_BASE_URL>/api/auth/jwks to verify JWTs.
AUTH_BASE_URL=http://localhost:3000

